# ============================================================
# LogClaw Platform — Environment Variables
# Copy this file to .env.local and fill in every value.
# ============================================================

# -----------------------------------------------------------
# Authentication (Clerk)
# Get these from: https://dashboard.clerk.com → your app → API Keys
# -----------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clerk redirect URLs — leave these as-is unless you change the routes
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboard

# -----------------------------------------------------------
# Database (Supabase)
# IMPORTANT: Use the Transaction Pooler URL (port 6543), NOT the direct URL.
# Get it from: Supabase Dashboard → Settings → Database → Connection string → Transaction pooler
# -----------------------------------------------------------
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# -----------------------------------------------------------
# GitHub App
# Create a GitHub App at: https://github.com/settings/apps
# The app creates Helm values PRs during customer onboarding.
# -----------------------------------------------------------
GITHUB_APP_ID=123456
# Base64-encode your PEM key: base64 -i logclaw.pem | tr -d '\n'
GITHUB_APP_PRIVATE_KEY=LS0tLS1CRUdJTi...
GITHUB_APP_WEBHOOK_SECRET=your-random-webhook-secret
# URL format: https://github.com/apps/YOUR_APP_NAME/installations/new
NEXT_PUBLIC_GITHUB_APP_INSTALL_URL=https://github.com/apps/logclaw/installations/new

# -----------------------------------------------------------
# Agent JWT
# Shared secret used to verify metric pushes from the logclaw-agent.
# Generate one: openssl rand -hex 32
# The same value must be stored in the Kubernetes Secret in every cluster.
# -----------------------------------------------------------
LOGCLAW_AGENT_JWT_SECRET=your-32-byte-hex-secret-here

# -----------------------------------------------------------
# Optional
# -----------------------------------------------------------
# Calendly link shown on the pricing page "Talk to us" button
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-link
